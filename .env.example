# ==========================================================================
#  Ona tili RASH platformasi — muhit o'zgaruvchilari
#  Ushbu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# ==========================================================================

# --- Telegram ---
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bot username (deep-link yasash uchun, @ belgisisiz)
BOT_USERNAME=rashonatilibot

# Asosiy adminlarning Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# Majburiy obuna kanali (@ bilan yoki -100... ko'rinishidagi ID)
REQUIRED_CHANNEL=@Oybek_ustoz_MS

# Kanalga havola (foydalanuvchiga ko'rsatiladigan tugma uchun)
REQUIRED_CHANNEL_URL=https://t.me/Oybek_ustoz_MS

# Majburiy obunani butunlay o'chirish uchun: 0
SUBSCRIPTION_REQUIRED=1


# --- Django ---
DJANGO_ENV=dev
DJANGO_SECRET_KEY=o-zgartiring-bu-maxfiy-kalitni
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Tashkent


# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirilsa SQLite ishlatiladi (data/db.sqlite3).
# PostgreSQL misoli:
# DATABASE_URL=postgres://rasch:parol@localhost:5432/raschbot
DATABASE_URL=


# --- Web / Mini App ---
# Mini App va QR-kod uchun ochiq (public) HTTPS manzil.
# Lokal ishlab chiqishda ngrok/cloudflared manzilini qo'ying.
PUBLIC_BASE_URL=http://127.0.0.1:8000


# --- Sertifikat ---
CERT_ORGANIZATION=Oybek Ona tili markazi
CERT_ORGANIZER_NAME=
CERT_PLATFORM_NAME=Ona tili RASH platformasi
